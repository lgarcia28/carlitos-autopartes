{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "archivos/**",
      "tests/**",
      "**/*.xls",
      "**/*.xlsx",
      "**/*.cjs",
      "**/*.md",
      "package.json",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|mjs|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
