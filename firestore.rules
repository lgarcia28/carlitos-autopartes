rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products are readable by anyone for the online store, writable only by authenticated admin
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // All other collections (invoices, contacts, payments, checks, expenses) accessible only by authenticated admin
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
