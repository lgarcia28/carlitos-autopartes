rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores autorizados. DEBE coincidir con CORREOS_AUTORIZADOS en control.js.
    // No se usa comodín de dominio: cualquiera podría registrar una cuenta con ese dominio.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'leoneldariogarcia@gmail.com',
          'carlitos@carlitosautopartes.com'
        ];
    }

    // Catálogo: lectura pública para la tienda online, escritura solo admins.
    match /products/{product} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Datos comerciales/financieros: solo admins.
    match /invoices/{id}  { allow read, write: if isAdmin(); }
    match /contacts/{id}  { allow read, write: if isAdmin(); }
    match /payments/{id}  { allow read, write: if isAdmin(); }
    match /checks/{id}    { allow read, write: if isAdmin(); }
    match /expenses/{id}  { allow read, write: if isAdmin(); }

    // Todo lo demás queda denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
